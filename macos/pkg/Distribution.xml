<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Ext4 for Mac</title>
    <organization>dev.watzon</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="true" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="15.4"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="Ext4 for Mac">
        <pkg-ref id="dev.watzon.macext4"/>
    </choice>
    <pkg-ref id="dev.watzon.macext4" version="__VERSION__" onConclusion="none">Ext4-component.pkg</pkg-ref>
</installer-gui-script>
